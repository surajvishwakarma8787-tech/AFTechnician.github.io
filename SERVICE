import React from "react";
import { Link } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Snowflake, Wind, Building, Smartphone, Grid3x3, ArrowRight } from "lucide-react";

export default function Services() {
  const acTypes = [
    {
      id: "split",
      name: "Split AC",
      icon: Snowflake,
      image: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80",
      description: "Most popular choice for homes and offices. Energy efficient and quiet operation.",
      features: ["Energy Efficient", "Quiet Operation", "Remote Control", "Timer Function"],
      priceRange: "₹25,000 - ₹60,000"
    },
    {
      id: "window",
      name: "Window AC",
      icon: Wind,
      image: "https://images.unsplash.com/photo-1585208798174-6cedd86e019a?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2073&q=80",
      description: "Compact and affordable cooling solution for small to medium rooms.",
      features: ["Compact Design", "Easy Installation", "Cost Effective", "Low Maintenance"],
      priceRange: "₹15,000 - ₹35,000"
    },
    {
      id: "central",
      name: "Central AC",
      icon: Building,
      image: "https://images.unsplash.com/photo-1504253163759-c23fccaebb55?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80",
      description: "Perfect for large homes and commercial spaces with multiple rooms.",
      features: ["Whole Building Cooling", "Energy Efficient", "Even Temperature", "Professional Installation"],
      priceRange: "₹1,50,000 - ₹5,00,000"
    },
    {
      id: "portable",
      name: "Portable AC",
      icon: Smartphone,
      image: "https://images.unsplash.com/photo-1614961234441-8b3f0c3ea3da?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1974&q=80",
      description: "Mobile cooling solution that can be moved from room to room.",
      features: ["Portable Design", "No Installation", "Flexible Placement", "Instant Cooling"],
      priceRange: "₹20,000 - ₹45,000"
    },
    {
      id: "cassette",
      name: "Cassette AC",
      icon: Grid3x3,
      image: "https://images.unsplash.com/photo-1581833971358-2c8b550f87b3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2071&q=80",
      description: "Ceiling-mounted units ideal for offices and commercial spaces.",
      features: ["360° Air Flow", "Space Saving", "Professional Look", "Even Cooling"],
      priceRange: "₹40,000 - ₹80,000"
    }
  ];

  const services = [
    {
      title: "Installation Service",
      description: "Professional installation with proper mounting, electrical connections, and testing.",
      price: "₹2,000 - ₹5,000",
      duration: "2-4 hours",
      includes: ["Site survey", "Mounting & fitting", "Electrical connections", "Testing & commissioning"]
    },
    {
      title: "Repair Service",
      description: "Quick diagnosis and repair of AC problems with genuine spare parts.",
      price: "₹500 - ₹3,000",
      duration: "1-2 hours",
      includes: ["Problem diagnosis", "Repair work", "Parts replacement", "Performance testing"]
    },
    {
      title: "Maintenance Service",
      description: "Regular maintenance to keep your AC running efficiently and extend its life.",
      price: "₹800 - ₹1,500",
      duration: "1 hour",
      includes: ["Filter cleaning", "Coil cleaning", "Gas pressure check", "Performance optimization"]
    },
    {
      title: "Emergency Service",
      description: "24/7 emergency repair service for urgent AC problems.",
      price: "₹1,000 - ₹4,000",
      duration: "30 minutes response",
      includes: ["Immediate response", "Emergency repair", "Temporary solutions", "Follow-up service"]
    }
  ];

